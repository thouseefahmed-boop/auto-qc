FROM python:3.12-slim
WORKDIR /app
COPY requirements.lock ./
COPY _build/alfred /opt/alfred
RUN pip install --no-cache-dir -r requirements.lock /opt/alfred
COPY pyproject.toml worker_client.py ./
COPY autoqc ./autoqc
RUN pip install --no-cache-dir --no-deps .
EXPOSE 8810
CMD ["python", "-m", "autoqc.serve"]
